        }
      }
    },
    "UMC 활동에 사용할 정보를 입력해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UMC 활동에 사용할 정보를 입력해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the details you'll use for UMC activities."
          }
        }
      }
    },
    "UMC 회원 정보를 확인해요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UMC 회원 정보를 확인해요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking your UMC membership"
          }
        }
      }
    },
    "UMC에 오신 것을 환영해요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UMC에 오신 것을 환영해요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to UMC"
          }
        }
      }
    },
    "[필수] 개인정보 처리방침": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[필수] 개인정보 처리방침"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[Required] Privacy Policy"
          }
        }
      }
    },
    "[필수] 서비스 이용약관": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[필수] 서비스 이용약관"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[Required] Terms of Service"
          }
        }
      }
    },
    "https:// 또는 http://로 시작하는 링크를 입력해 주세요. ": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "https:// 또는 http://로 시작하는 링크를 입력해 주세요. "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a link starting with https:// or http://. "
          }
        }
      }
    },
    "https:// 또는 http://로 시작하는 링크를 입력해 주세요. 로그인 정보가 포함된 주소는 사용할 수 없어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "https:// 또는 http://로 시작하는 링크를 입력해 주세요. 로그인 정보가 포함된 주소는 사용할 수 없어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a link starting with https:// or http://. Addresses containing login credentials are not supported."
          }
        }
      }
    },
    "macOS 로그인 항목에서 실행을 승인해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 로그인 항목에서 실행을 승인해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve this app in macOS Login Items."
          }
        }
      }
    },
    "macOS 설정 열기": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 설정 열기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open macOS Settings"
          }
        }
      }
    },
    "macOS 설정에서 알림을 허용할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 설정에서 알림을 허용할 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can allow notifications in macOS settings."
          }
        }
      }
    },
    "macOS 알림": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 알림"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS notifications"
          }
        }
      }
    },
    "macOS에서 권한을 허용해도 출석 · 공지 · 메시지 알림은 아직 오지 않아요.\n앱이 종료된 동안 받는 원격 푸시는 제공하지 않아요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS에서 권한을 허용해도 출석 · 공지 · 메시지 알림은 아직 오지 않아요.\n앱이 종료된 동안 받는 원격 푸시는 제공하지 않아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendance, notice, and message notifications are not yet delivered, even with macOS permission.\nRemote push notifications while the app is closed are not available."
          }
        }
      }
    },
    "macOS의 접근성 설정을 그대로 따라요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS의 접근성 설정을 그대로 따라요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows macOS accessibility settings."
          }
        }
      }
    },
    "‘%@’ 테마를 삭제할까요?": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ 테마를 삭제할까요?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the “%@” theme?"
          }
        }
      }
    },
    "“결국 가장 소중한 것은\n자기 마음의 온전함입니다.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“결국 가장 소중한 것은\n자기 마음의 온전함입니다.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Nothing is at last sacred\nbut the integrity of your own mind.”"
          }
        }
      }
    },
    "“꿈을 향해 자신 있게\n나아가고 상상한 삶을\n살고자 노력하면,\n뜻밖의 성공을 만나게 됩니다.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“꿈을 향해 자신 있게\n나아가고 상상한 삶을\n살고자 노력하면,\n뜻밖의 성공을 만나게 됩니다.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Go confidently toward your dreams\nand live the life you have imagined,\nand you will meet unexpected success.”"
          }
        }
      }
    },
    "“남을 아는 사람은 지혜롭고,\n자신을 아는 사람은\n밝습니다.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“남을 아는 사람은 지혜롭고,\n자신을 아는 사람은\n밝습니다.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Knowing others is wisdom;\nknowing yourself is enlightenment.”"
          }
        }
      }
    },
    "“남을 이기는 사람은 강하고,\n자신을 이기는 사람은\n더 강합니다.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“남을 이기는 사람은 강하고,\n자신을 이기는 사람은\n더 강합니다.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Mastering others is strength;\nmastering yourself is true power.”"
          }
        }
      }
    },
    "“단순하게,\n더 단순하게 살아가세요.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“단순하게,\n더 단순하게 살아가세요.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Simplify, simplify.”"
          }
        }
      }
    },
    "“먼 곳에서 벗이 찾아오니\n기쁘지 않나요?”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“먼 곳에서 벗이 찾아오니\n기쁘지 않나요?”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Is it not a joy to have friends\ncome from afar?”"
          }
        }
      }
    },
    "“무슨 일이 생기더라도,\n그 안에서 도움이 되는 것을\n찾아낼 수 있습니다.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“무슨 일이 생기더라도,\n그 안에서 도움이 되는 것을\n찾아낼 수 있습니다.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“In every event,\nfind something that helps you.”"
          }
        }
      }
    },
    "“배우고 꾸준히 익히면\n즐겁지 않나요?”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“배우고 꾸준히 익히면\n즐겁지 않나요?”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Is it not a pleasure to learn\nand practice what you have learned?”"
          }
        }
      }
    },
    "“배움에 힘쓰는 사람은\n날마다 지식을 더해갑니다.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“배움에 힘쓰는 사람은\n날마다 지식을 더해갑니다.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“In the pursuit of learning,\nevery day something is acquired.”"
          }
        }
      }
    },
    "“삶이 넉넉하지 않더라도\n자신의 삶을 사랑하세요.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“삶이 넉넉하지 않더라도\n자신의 삶을 사랑하세요.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Love your life,\npoor as it is.”"
          }
        }
      }
    },
    "“생각 없이 배우면 헛되고,\n배움 없이 생각하면\n위태롭습니다.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“생각 없이 배우면 헛되고,\n배움 없이 생각하면\n위태롭습니다.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Learning without thought is labor lost;\nthought without learning is perilous.”"
          }
        }
      }
    },
    "“아는 것은 안다고,\n모르는 것은 모른다고\n하는 것이 참된 앎입니다.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“아는 것은 안다고,\n모르는 것은 모른다고\n하는 것이 참된 앎입니다.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“To know what you know, and to know\nwhat you do not know, is true knowledge.”"
          }
        }
      }
    },
    "“아는 사람은 좋아하는\n사람만 못하고,\n좋아하는 사람은 즐기는\n사람만 못합니다.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“아는 사람은 좋아하는\n사람만 못하고,\n좋아하는 사람은 즐기는\n사람만 못합니다.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Those who love learning surpass those\nwho know; those who delight in it\nsurpass those who love it.”"
          }
        }
      }
    },
    "“아름드리나무도\n아주 작은 싹에서\n자라났습니다.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“아름드리나무도\n아주 작은 싹에서\n자라났습니다.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“A tree that fills the arms\ngrows from a tiny shoot.”"
          }
        }
      }
    },
    "“어떤 일이 생기면,\n그 일에 쓸 수 있는 힘이\n내 안에 무엇인지 살펴보세요.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“어떤 일이 생기면,\n그 일에 쓸 수 있는 힘이\n내 안에 무엇인지 살펴보세요.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“For every event, look within\nfor the strength to face it.”"
          }
        }
      }
    },
    "“어려운 일은\n아직 쉬울 때 준비하세요.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“어려운 일은\n아직 쉬울 때 준비하세요.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Prepare for the difficult\nwhile it is still easy.”"
          }
        }
      }
    },
    "“여러분의 시간은\n한정돼 있습니다.\n다른 사람의 삶을 사느라\n낭비하지 마세요.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“여러분의 시간은\n한정돼 있습니다.\n다른 사람의 삶을 사느라\n낭비하지 마세요.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Your time is limited.\nDon't waste it living\nsomeone else's life.”"
          }
        }
      }
    },
    "“열정 없이 이루어진\n위대한 일은 없습니다.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“열정 없이 이루어진\n위대한 일은 없습니다.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Nothing great was ever achieved\nwithout enthusiasm.”"
          }
        }
      }
    },
    "“우리가 깨어 있어야\n새로운 날도 밝아옵니다.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“우리가 깨어 있어야\n새로운 날도 밝아옵니다.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Only that day dawns\nto which we are awake.”"
          }
        }
      }
    },
    "“우리를 흔드는 것은\n사건 자체가 아니라,\n그 사건을 바라보는\n우리의 생각입니다.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“우리를 흔드는 것은\n사건 자체가 아니라,\n그 사건을 바라보는\n우리의 생각입니다.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“People are disturbed not by things,\nbut by the views they take of them.”"
          }
        }
      }
    },
    "“일이 바라는 대로 되기를\n요구하기 보다,\n일어난 일을 받아들이세요.\n그러면 잘 지낼 수 있습니다.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“일이 바라는 대로 되기를\n요구하기 보다,\n일어난 일을 받아들이세요.\n그러면 잘 지낼 수 있습니다.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Do not demand that events happen\nas you wish. Accept them as they happen,\nand you will get on well.”"
          }
        }
      }
    },
    "“자신에게 들리는 음악에\n맞춰 걸어가세요.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“자신에게 들리는 음악에\n맞춰 걸어가세요.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Step to the music\nwhich you hear.”"
          }
        }
      }
    },
    "“자신에게 평온을 가져다줄\n수 있는 사람은\n바로 자신입니다.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“자신에게 평온을 가져다줄\n수 있는 사람은\n바로 자신입니다.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Nothing can bring you peace\nbut yourself.”"
          }
        }
      }
    },
    "“자신을 믿으세요.\n모든 마음은 그 단단한\n현의 울림에 응답합니다.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“자신을 믿으세요.\n모든 마음은 그 단단한\n현의 울림에 응답합니다.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Trust thyself: every heart\nvibrates to that iron string.”"
          }
        }
      }
    },
    "“자신의 길을 고수하세요.\n다른 사람을\n흉내 내지 마세요.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“자신의 길을 고수하세요.\n다른 사람을\n흉내 내지 마세요.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Insist on yourself;\nnever imitate.”"
          }
        }
      }
    },
    "“자신의 삶에 만족할 줄\n아는 사람이 부유합니다.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“자신의 삶에 만족할 줄\n아는 사람이 부유합니다.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“One who knows contentment\nis rich.”"
          }
        }
      }
    },
    "“자신의 일을 해내세요.\n그렇게 자신을\n더 단단하게 만드세요.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“자신의 일을 해내세요.\n그렇게 자신을\n더 단단하게 만드세요.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Do your work,\nand you shall reinforce yourself.”"
          }
        }
      }
    },
    "“자신이 하는 일을 좋아하세요.\n그러면 최선을 다하게 됩니다.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“자신이 하는 일을 좋아하세요.\n그러면 최선을 다하게 됩니다.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Like what you do,\nand then you will do your best.”"
          }
        }
      }
    },
    "“잘못하고도 고치지 않는 것,\n그것이 진짜 잘못입니다.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“잘못하고도 고치지 않는 것,\n그것이 진짜 잘못입니다.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“To make a mistake and not correct it\nis a real mistake.”"
          }
        }
      }
    },
    "“천 리 길도\n한 걸음부터 시작됩니다.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“천 리 길도\n한 걸음부터 시작됩니다.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“A journey of a thousand miles\nbegins with a single step.”"
          }
        }
      }
    },
    "“친구란 내가 진솔해질 수\n있는 사람입니다.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“친구란 내가 진솔해질 수\n있는 사람입니다.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“A friend is a person\nwith whom I may be sincere.”"
          }
        }
      }
    },
    "“혼자서는 할 수 있는 일이\n적지만, 함께라면 많은 일을\n할 수 있습니다.”": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“혼자서는 할 수 있는 일이\n적지만, 함께라면 많은 일을\n할 수 있습니다.”"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Alone we can do so little;\ntogether we can do so much.”"
          }
        }
      }
    },
